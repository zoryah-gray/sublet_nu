# `vercel env pull` overwrites .env.local, so re-add these after running it.

# ── Local Postgres (docker-compose `db` service) ─────────────────────────────
# The postgres image creates this user/password/database on the volume's FIRST
# boot only. Changing them later needs `docker compose down -v` (wipes data) or
# an ALTER USER inside the database.
# Generate the password with `openssl rand -hex 24`. Use hex, not -base64:
# base64 can contain / + =, which break DATABASE_URL unless URL-encoded.
POSTGRES_USER=sublet_nu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sublet_nu
# Port the db service is published on, on 127.0.0.1 only (docker-compose.yml).
# Change it here if something else on your machine already uses 5432.
POSTGRES_PORT=5432

# ── node-pg-migrate + backend DB tests (run on your machine) ─────────────────
# node-pg-migrate reads DATABASE_URL by default; the jest DB test reads the same.
# Required for migrate:* and npm test, which run on your machine, not in a
# container. Built from the values above so the password lives in one place:
# `set -a && source .env.local && set +a` expands the ${...} references. The
# dev container builds its own URL with host `db` in docker-compose.yml.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# ── AWS CDK (apps/backend) ───────────────────────────────────────────────────
# Email subscribed to the billing-alerts SNS topic. `cdk synth` fails without it.
# Alternative: pass -c alertEmail=you@example.com instead.
ALERT_EMAIL=
