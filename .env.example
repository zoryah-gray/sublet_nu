POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000/api/auth
# Local Postgres (docker-compose `db` service). POSTGRES_USER/POSTGRES_PASSWORD
# above are reused; POSTGRES_DB names the database the image creates.
# DATABASE_URL points at localhost for host-run tools (node-pg-migrate, jest);
# the dev container builds its own URL with host `db` in docker-compose.yml.
#   POSTGRES_USER=sublet_nu
#   POSTGRES_DB=sublet_nu
#   DATABASE_URL=postgres://sublet_nu:<password>@localhost:5432/sublet_nu
POSTGRES_DB=
DATABASE_URL=
